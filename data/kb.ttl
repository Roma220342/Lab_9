hr:situationS1 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Підтвердження після випробувального терміну"@uk ;
    hr:fromState hr:stateProbation ;
    hr:guard "productivityScore ≥ 6.0" ;
    hr:observedBy hr:sensorKPI ;
    hr:onEvent hr:eventProbationMaria ;
    hr:performsAction hr:actionConfirmEmployment ;
    hr:toState hr:stateActive .

hr:situationS2 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Ініціювання звільнення за низької продуктивності"@uk ;
    hr:fromState hr:stateActive ;
    hr:guard "productivityScore < 5.0 три квартали поспіль" ;
    hr:observedBy hr:sensorKPI ;
    hr:onEvent hr:eventLowProdPetro ;
    hr:performsAction hr:actionInitiateDismissal ;
    hr:toState hr:stateUnderReview .

hr:situationS3 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Початок адаптації нового співробітника"@uk ;
    hr:fromState hr:stateCandidate ;
    hr:guard "рішення про прийом схвалено керівником" ;
    hr:observedBy hr:sensorHRIS ;
    hr:onEvent hr:eventHire1 ;
    hr:performsAction hr:actionStartOnboarding ;
    hr:toState hr:stateOnboarding .

hr:situationS4 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Завершення курсу навчання"@uk ;
    hr:fromState hr:stateActive ;
    hr:guard "courseHours ≥ 8" ;
    hr:observedBy hr:sensorLMS ;
    hr:onEvent hr:eventCourseAndriy ;
    hr:performsAction hr:actionUpdateCompetence ;
    hr:toState hr:stateActive .

hr:situationS5 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Низька продуктивність: призначення курсу"@uk ;
    hr:fromState hr:stateActive ;
    hr:guard "5.0 ≤ productivityScore < 6.5" ;
    hr:observedBy hr:sensorKPI ;
    hr:onEvent hr:eventLowProdPetro ;
    hr:performsAction hr:actionAssignCourse ;
    hr:toState hr:stateActive .

hr:situationS6 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Заява про звільнення"@uk ;
    hr:fromState hr:stateActive ;
    hr:guard "заява зареєстрована в HRIS" ;
    hr:observedBy hr:sensorHRIS ;
    hr:onEvent hr:eventResignation1 ;
    hr:performsAction hr:actionCloseRecord ;
    hr:toState hr:stateDismissed .

